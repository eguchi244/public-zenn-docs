{
  "permissions": {
    "allow": [
      "Bash(npx zenn:*)",
      "Bash(npm install)",
      "Bash(npm ls:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git show:*)",
      "Bash(git check-ignore:*)",
      "Bash(git ls-files:*)"
    ],
    "ask": [
      "Bash(git branch -d:*)",
      "Bash(git branch -D:*)",
      "Bash(git branch --delete:*)"
    ]
  },
  "hooks": {
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/save_instruction_log.ps1\""
          }
        ]
      }
    ]
  }
}
